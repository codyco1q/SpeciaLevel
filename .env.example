# ==============================================================================
# SpeciaLevel Environment Variables
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase (Database & Authentication)
# ------------------------------------------------------------------------------
# Project URL from Supabase Dashboard (Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Public Anon Key (safe for browser exposure)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Service Role Key (NEVER expose to client; used in admin routes/webhooks)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ------------------------------------------------------------------------------
# 2. Application & Public URLs
# ------------------------------------------------------------------------------
# Canonical URL of your deployment (used for Stripe redirects, public invoice links, etc.)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 3. Payments (Stripe)
# ------------------------------------------------------------------------------
# Stripe Secret API Key (sk_test_... or sk_live_...)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key

# Stripe Webhook Endpoint Secret (whsec_...) for validating incoming webhook events
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# ------------------------------------------------------------------------------
# 4. AI & LLM Services
# ------------------------------------------------------------------------------
# Global/fallback API Key for OpenAI / BYOK AI execution
AI_API_KEY=sk-your-ai-or-openai-api-key
OPENAI_API_KEY=sk-your-ai-or-openai-api-key

# Optional custom OpenAI-compatible API base URL (e.g. Ollama, vLLM, OpenRouter, Azure)
AI_CUSTOM_API_BASE=
OPENAI_BASE_URL=

# ------------------------------------------------------------------------------
# 5. Marketing & Webhooks
# ------------------------------------------------------------------------------
# Optional webhook URL for forwarding marketing contact form submissions (Make / Zapier)
MARKETING_LEADS_WEBHOOK_URL=

# Optional organization-level notification webhook URL
ORGANIZATION_WEBHOOK_URL=

# ------------------------------------------------------------------------------
# 6. Testing & Development
# ------------------------------------------------------------------------------
# Base URL for Playwright E2E testing suite
E2E_BASE_URL=http://localhost:3000

